{
  "name": "4pay/sdk",
  "description": "Official SDK for the 4pay.online payment platform — payments, payouts, refunds, webhooks and agentic commerce",
  "type": "library",
  "license": "MIT",
  "homepage": "https://docs.4pay.online/docs/partners/sdk",
  "support": {
    "source": "https://github.com/4pay-online/sdk-php",
    "issues": "https://github.com/4pay-online/sdk-php/issues"
  },
  "keywords": [
    "payments",
    "4pay",
    "psp",
    "agentic-commerce",
    "ap2",
    "acp",
    "a2a",
    "mcp"
  ],
  "require": {
    "php": ">=8.1",
    "ext-json": "*",
    "ext-curl": "*",
    "ext-bcmath": "*"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0"
  },
  "autoload": {
    "psr-4": {
      "FourPay\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "FourPay\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "php tests/run.php"
  }
}
